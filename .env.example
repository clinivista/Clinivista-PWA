# Local development environment for `pnpm dev`.
# Copy to `.env` and adjust. `.env` is git-ignored; never commit real secrets.
# On Replit these values come from Secrets / the platform, not from this file.

# --- Required -----------------------------------------------------------------

# PostgreSQL connection string (used by the API and `pnpm --filter @workspace/db run push`).
DATABASE_URL=postgres://localhost:5432/clinivista

# Ports for each process. `pnpm dev` passes them to each one as PORT.
API_PORT=3001
WEB_PORT=5173

# Base path the PWA is served from.
BASE_PATH=/

# --- Optional -----------------------------------------------------------------

# Admin panel password. Outside production it defaults to `demo-clinivista`.
# ADMIN_PASSWORD=

# Where clinical photos are stored on disk in development.
# CLINICAL_PHOTO_LOCAL_DIR=/tmp/estecapelli-private-photos

# Private S3-compatible bucket for clinical photos (Cloudflare R2 in production).
# Required in production; set all four or none. Leave unset locally to use
# CLINICAL_PHOTO_LOCAL_DIR instead.
#   S3_ENDPOINT          R2 S3 API endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_BUCKET            Bucket name (keep it private: no public access, no r2.dev URL)
#   S3_ACCESS_KEY_ID     "Access Key ID" of an R2 API token (Object Read & Write, this bucket only)
#   S3_SECRET_ACCESS_KEY "Secret Access Key" of that same token
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Only for non-R2 providers; R2 uses "auto".
# S3_REGION=auto

# DEFAULT_CENTER_ID=default-center
# DEFAULT_PROTOCOL_ID=
# LOG_LEVEL=info
